<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mock GPS route for "Stocznia Sound 2027" (Stocznia Gdańska), for demoing
  the app at a desk without a phone physically on-site. See
  assets/map/gps-mock/README.md for how to play this back on Android.

  Path: main gate -> S1 (Główna) -> S2 (Doki) -> S3 (Namiot Elektro) ->
  back towards the Plac Solidarności tram/bus stop, walking pace (~1.3 m/s).
-->
